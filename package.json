{
  "name": "umd-mcp",
  "mcpName": "io.github.avivkeller/umd-mcp",
  "version": "0.0.1",
  "description": "MCP server exposing University of Maryland data",
  "type": "module",
  "license": "MIT",
  "author": "Aviv Keller <me@aviv.sh>",
  "bin": {
    "umd-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "expiry-map": "^2.0.0",
    "fetch-cookie": "^3.2.0",
    "graphql-request": "^7.4.0",
    "gtfs": "^4.21.0",
    "html-to-text": "^10.0.1",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.14",
    "p-memoize": "^8.0.0",
    "parse-link-header": "^2.0.0",
    "playwright-core": "1.63.0",
    "qs": "^6.16.0",
    "rss-parser": "^3.13.0",
    "split-string": "^6.1.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.3",
    "@types/parse-link-header": "^2.0.3",
    "@types/qs": "^6.15.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
